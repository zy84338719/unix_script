msgid "1Panel is Linux-only. Current: "
msgstr "1Panel 仅支持 Linux。当前："

msgid "systemctl (systemd) is required."
msgstr "需要 systemctl（systemd）。"

msgid "Either curl or wget is required, please install one first."
msgstr "需要 curl 或 wget 之一，请先安装。"

msgid "Detected 1Panel installed ("
msgstr "检测到 1Panel 已安装（"

msgid "Unknown version"
msgstr "未知版本"

msgid ")"
msgstr "）"

msgid "Continue and reinstall/update?"
msgstr "是否继续并重装/更新？"

msgid "Cancelled"
msgstr "已取消"

msgid "Downloading official installer ("
msgstr "下载官方安装脚本（"

msgid ")..."
msgstr "）..."

msgid ""
"Running official installer (non-interactive if PANEL_* env vars are set)..."
msgstr "执行官方安装脚本（如已设置 PANEL_* 环境变量则按其非交互安装）..."

msgid "Party popper 1Panel installation complete!"
msgstr "🎉 1Panel 安装完成！"

msgid "View panel address/security entry/account: sudo 1pctl user-info"
msgstr "查看面板地址/安全入口/账号：sudo 1pctl user-info"

msgid "Common commands: 1pctl status | 1pctl restart | 1pctl update"
msgstr "常用命令：1pctl status | 1pctl restart | 1pctl update"

msgid ""
"Installer ran but 1pctl was not detected — check the output above to confirm "
"the result."
msgstr "安装脚本已执行，但未检测到 1pctl——请检查上方输出确认安装结果。"

msgid "1Panel is not installed."
msgstr "1Panel 未安装。"

msgid "1Panel is not installed, nothing to uninstall."
msgstr "1Panel 未安装，无需卸载。"

msgid ""
"Uninstalling does not delete the panel data directory (default /opt/1panel), "
"site and image data will be kept."
msgstr "卸载不会删除面板数据目录（默认 /opt/1panel），站点与镜像数据将保留。"

msgid "Confirm uninstall of 1Panel?"
msgstr "确认卸载 1Panel？"

msgid "1pctl uninstall failed, please check manually."
msgstr "1pctl uninstall 失败，请手动检查。"

msgid "1Panel uninstalled."
msgstr "1Panel 已卸载。"

msgid "Not applicable (Linux only)"
msgstr "不适用（仅 Linux）"

msgid "Not installed"
msgstr "未安装"

msgid "Installed and running"
msgstr "已安装并运行"

msgid "Installed (service not running)"
msgstr "已安装（服务未运行）"

msgid ""
"Install 1Panel (official v2 script, interactive/pass PANEL_* for non-"
"interactive, Linux only)"
msgstr "安装 1Panel（官方 v2 脚本，交互/透传 PANEL_* 非交互，仅 Linux）"

msgid "View panel address, security entry and account (1pctl user-info)"
msgstr "查看面板地址、安全入口与账号（1pctl user-info）"

msgid "Upgrade 1Panel (1pctl update)"
msgstr "升级 1Panel（1pctl update）"

msgid "Uninstall 1Panel (keep data directory)"
msgstr "卸载 1Panel（保留数据目录）"

msgid "View status"
msgstr "查看状态"

msgid "Unknown action: "
msgstr "未知操作: "

msgid "BT Panel is Linux-only. Current: "
msgstr "宝塔面板仅支持 Linux。当前："

msgid "Detected existing Web/database environment running: "
msgstr "检测到既有 Web/数据库环境在运行："

msgid ""
"BT Panel officially requires a clean system (it installs its own Nginx/"
"Apache/MySQL/PHP, which may conflict with existing services)."
msgstr ""
"宝塔官方要求在纯净系统上安装（会自建 Nginx/Apache/MySQL/PHP，易端口冲突）。"

msgid "Still continue installing BT Panel?"
msgstr "仍要继续安装宝塔面板？"

msgid "Running official installer (takes about 2 minutes)..."
msgstr "执行官方安装脚本（耗时约 2 分钟）..."

msgid "Detected BT Panel installed"
msgstr "检测到宝塔面板已安装"

msgid "Party popper BT Panel installation complete!"
msgstr "🎉 宝塔面板安装完成！"

msgid "View panel address/security entry/default password: sudo bt default"
msgstr "查看面板地址/安全入口/默认密码：sudo bt default"

msgid ""
"Make sure to open the panel port (default 8888, check bt default output) "
"before accessing."
msgstr "请务必放行面板端口（默认 8888，实际以 bt default 输出为准）后访问。"

msgid ""
"Installer ran but bt was not detected — check the output above to confirm "
"the result."
msgstr "安装脚本已执行，但未检测到 bt——请检查上方输出确认安装结果。"

msgid "Detected BT Panel/aaPanel installed, they cannot coexist."
msgstr "检测到宝塔/aaPanel 已安装，两者不能共存。"

msgid "Continue and reinstall?"
msgstr "是否继续并重装？"

msgid "Party popper aaPanel installation complete!"
msgstr "🎉 aaPanel 安装完成！"

msgid "View panel address/entry/default password: sudo bt default"
msgstr "查看面板地址/入口/默认密码：sudo bt default"

msgid "BT Panel is not installed."
msgstr "宝塔面板未安装。"

msgid "BT Panel is not installed, nothing to uninstall."
msgstr "宝塔面板未安装，无需卸载。"

msgid ""
"Will stop the panel and delete: /etc/init.d/bt, bt command, /www/server/"
"panel (panel and software environment)."
msgstr ""
"将停止面板并删除：/etc/init.d/bt、bt 命令、/www/server/panel（面板与软件环"
"境）。"

msgid ""
"Site data /www/wwwroot, logs /www/wwwlogs and database directories are kept "
"by default."
msgstr "站点数据 /www/wwwroot、日志 /www/wwwlogs 与数据库目录默认保留。"

msgid "Confirm uninstall of BT Panel?"
msgstr "确认卸载宝塔面板？"

msgid "Also delete site/database data (rm -rf /www, irreversible)?"
msgstr "是否连站点/数据库数据一并删除（rm -rf /www，不可恢复）？"

msgid "All data in /www has been deleted."
msgstr "已删除 /www 全部数据。"

msgid "BT Panel uninstalled."
msgstr "宝塔面板已卸载。"

msgid ""
"Install BT Panel (domestic version, download.bt.cn official script, Linux "
"only)"
msgstr "安装宝塔面板（国内版，download.bt.cn 官方脚本，仅 Linux）"

msgid "Install international version aaPanel (English UI)"
msgstr "安装国际版 aaPanel（英文界面）"

msgid "View panel address/security entry/default password (bt default)"
msgstr "查看面板地址/安全入口/默认密码（bt default）"

msgid ""
"Uninstall panel (site data kept by default, /www can be deleted after second "
"confirmation)"
msgstr "卸载面板（站点数据默认保留，二次确认后可选删除 /www）"

#, sh-printf-format
msgid "buildah %s is already installed, reinstall?"
msgstr "已检测到 buildah %s，是否重新安装？"

msgid "Installing buildah via system repositories..."
msgstr "通过系统仓库安装 buildah..."

msgid "buildah install failed (package not in system repos?)"
msgstr "buildah 安装失败（系统仓库无该包？）"

msgid "buildah installed. Try: buildah from alpine:latest"
msgstr "buildah 安装完成。试一下：buildah from alpine:latest"

msgid "Companion image tool: ./install.sh skopeo"
msgstr "配套镜像搬运工具：./install.sh skopeo"

msgid "buildah not installed"
msgstr "buildah 未安装"

msgid "Confirm uninstall of buildah?"
msgstr "确认卸载 buildah？"

msgid "Uninstall failed"
msgstr "安装失败"

msgid "buildah uninstalled"
msgstr "buildah 已卸载"

#, sh-printf-format
msgid "Delete user container storage %s (images/layers, irreversible)?"
msgstr "是否删除用户容器存储 %s（镜像/层，不可恢复）？"

msgid "Storage deleted"
msgstr "存储已删除"

msgid "Storage kept"
msgstr "保留存储"

msgid "buildah installed"
msgstr "未安装"

msgid "(unknown version)"
msgstr "未知版本"

msgid "buildah - OCI image build tool (Linux only)"
msgstr "buildah —— OCI 镜像构建工具（仅 Linux）"

msgid "Install buildah via system repositories"
msgstr "通过系统仓库安装 buildah"

msgid ""
"Uninstall (user container storage kept by default, deletion needs second "
"confirmation)"
msgstr "卸载面板（站点数据默认保留，二次确认后可选删除 /www）"

msgid "View install status (supports UXS_STATUS_MODE=machine)"
msgstr "查看安装状态（支持 UXS_STATUS_MODE=machine）"

msgid "This help"
msgstr "本帮助"

msgid ""
"Note: no local container storage on macOS, buildah is unavailable, this "
"module is hidden on macOS."
msgstr "说明：macOS 上无本地容器存储，buildah 不可用，本模块在 macOS 隐藏。"

msgid "You can also build images with podman build (Dockerfile compatible)."
msgstr "构建镜像也可用 podman build（Dockerfile 兼容）。"

#, fuzzy, sh-printf-format
msgid "Unknown subcommand: %s"
msgstr "未知操作: "

msgid "Detected installed Docker"
msgstr "检测到已安装 Docker"

msgid "Continue and try to update?"
msgstr "是否继续并尝试更新？"

msgid ""
"Install from a domestic mirror (linuxmirrors.cn, includes registry "
"acceleration, recommended for China network)?"
msgstr "是否使用国内镜像源安装（linuxmirrors.cn，含镜像加速，国内网络推荐）？"

msgid "Installing Docker via domestic mirror script (linuxmirrors.cn)..."
msgstr "使用国内镜像源一键脚本（linuxmirrors.cn）安装/换源 Docker..."

msgid "Domestic mirror script failed, try the official installer instead"
msgstr "国内镜像源安装脚本执行失败，可改用官方源重试"

msgid "Installing Docker via pacman..."
msgstr "通过 pacman 安装 Docker..."

msgid "Install failed"
msgstr "安装失败"

msgid "Installing Docker via apk..."
msgstr "通过 apk 安装 Docker..."

msgid "Installing Docker via zypper..."
msgstr "通过 zypper 安装 Docker..."

msgid "Installing Docker Engine via official script (get.docker.com)..."
msgstr "使用官方一键脚本安装 Docker Engine（get.docker.com）..."

msgid "Official installer failed, check the network or install manually:"
msgstr "官方安装脚本执行失败，请检查网络或参考以下链接手动安装:"

msgid "Enabling and starting docker service..."
msgstr "启用并启动 docker 服务..."

msgid "Current user is already in the docker group"
msgstr "当前用户已在 docker 组中"

msgid "Add user"
msgstr "是否将用户"

msgid "to the docker group (passwordless docker, requires re-login)?"
msgstr "加入 docker 组（免 sudo 使用 docker，需重新登录生效）？"

msgid ""
"Log out and back in (or run newgrp docker) for the change to take effect."
msgstr "请注销并重新登录（或执行 newgrp docker）后生效。"

msgid ""
"docker compose subcommand not detected. Recent Docker includes the compose "
"plugin."
msgstr "未检测到 docker compose 子命令。新版 Docker 已内置 compose 插件；"

msgid "For standalone docker-compose, see:"
msgstr "如需独立 docker-compose，请参考:"

msgid "Docker installed: "
msgstr "Docker 已安装："

msgid "Docker Desktop is recommended on macOS."
msgstr "macOS 上推荐使用 Docker Desktop。"

msgid "Install Docker Desktop via Homebrew (--cask)?"
msgstr "是否通过 Homebrew 安装 Docker Desktop（--cask）？"

msgid "Installation complete. Please launch Docker Desktop to finish setup."
msgstr "安装完成，请启动 Docker Desktop 应用以完成初始化。"

msgid "Please download and install manually:"
msgstr "请手动下载安装:"

msgid "Rocket Starting Docker installation"
msgstr "🚀 开始安装 Docker"

msgid "Party popper Docker installation flow complete"
msgstr "🎉 Docker 安装流程结束"

msgid "Verify:"
msgstr "验证："

msgid "Test run (first pull is slow)"
msgstr "测试运行（首次拉取镜像较慢）"

msgid ""
"Docker Desktop may not have been installed via brew, please uninstall "
"manually."
msgstr "Docker Desktop 可能未通过 brew 安装，请手动卸载。"

msgid "Please uninstall Docker Desktop manually."
msgstr "请手动卸载 Docker Desktop。"

msgid "Uninstalling will stop the docker service and remove the package."
msgstr "卸载将停止 docker 服务并移除软件包。"

msgid ""
"Image/container/volume data is kept in /var/lib/docker, please clean it up "
"manually."
msgstr "镜像/容器/卷数据保留在 /var/lib/docker，需另行手动清理。"

msgid "Confirm uninstall of Docker Engine?"
msgstr "确认卸载 Docker Engine？"

msgid ""
"Also delete all images/containers/volumes (/var/lib/docker, /var/lib/"
"containerd)? This is irreversible!"
msgstr ""
"是否同时删除所有镜像/容器/卷（/var/lib/docker, /var/lib/containerd）？此操作"
"不可逆！"

msgid "Data directory deleted."
msgstr "数据目录已删除。"

msgid "Docker uninstalled."
msgstr "Docker 已卸载。"

msgid "Installed but service not running"
msgstr "已安装但服务未运行"

msgid ""
"Installed, but the Docker daemon is not running (please start Docker Desktop)"
msgstr "已安装，但 Docker 守护进程未运行（请启动 Docker Desktop）"

msgid "Registry mirror configuration (linuxmirrors) is Linux-only. Current: "
msgstr "镜像加速器换源（linuxmirrors）仅支持 Linux。当前："

msgid ""
"Docker not detected. The registry mirror configuration will only take effect "
"after Docker is installed and started."
msgstr ""
"未检测到 Docker。镜像加速器配置写入 /etc/docker/daemon.json 后需安装并启动 "
"Docker 才会生效。"

msgid "Still continue?"
msgstr "仍然继续？"

msgid ""
"Calling linuxmirrors script to configure registry mirror only (--only-"
"registry)..."
msgstr "调用 linuxmirrors 官方脚本仅更换镜像加速器（--only-registry）..."

msgid ""
"(The script will back up daemon.json and write a domestic mirror address)"
msgstr "（脚本会备份现有 daemon.json 并写入国内加速地址）"

msgid ""
"Registry mirror configuration failed, check the network or configure "
"manually:"
msgstr "镜像加速器换源失败，请检查网络或参考以下链接手动配置："

msgid "Registry mirror configuration complete."
msgstr "镜像加速器换源完成。"

msgid "If Docker is already running, restart it to apply:"
msgstr "如已运行 Docker，可重启使配置生效:"

msgid "Domestic mirror installation (linuxmirrors) is Linux-only. Current: "
msgstr "国内镜像源安装（linuxmirrors）仅支持 Linux。当前："

msgid ""
"Calling linuxmirrors script to install/replace Docker mirror (includes "
"registry acceleration)..."
msgstr "调用 linuxmirrors 官方脚本安装/换源 Docker（含国内镜像加速）..."

msgid "Domestic mirror script failed, check the network"
msgstr "国内镜像源安装脚本执行失败，请检查网络"

msgid "Docker mirror installation/replacement complete."
msgstr "Docker 镜像源安装/换源完成。"

msgid "Common commands:"
msgstr "常用命令:"

msgid "View registry mirror"
msgstr "查看镜像加速器"

msgid "Install or update Docker (optional domestic mirror)"
msgstr "安装或更新 Docker（可选国内镜像源）"

msgid ""
"Install/replace Docker via domestic mirror (linuxmirrors.cn), includes "
"registry acceleration"
msgstr "使用国内镜像源（linuxmirrors.cn）安装/换源 Docker，含镜像加速"

msgid "Configure registry mirror only (no reinstall, Linux only)"
msgstr "仅更换 Docker 镜像加速器（不重装 Docker，仅 Linux）"

msgid "Uninstall Docker"
msgstr "卸载 Docker"

msgid "View installation and running status"
msgstr "查看安装与运行状态"
