msgstr "通过 Homebrew 安装 Restic..."

msgid "Installing Restic via apt..."
msgstr "通过 apt 安装 Restic..."

msgid "Installation failed, falling back to the GitHub binary..."
msgstr "安装失败，改用 GitHub 二进制..."

#, sh-printf-format
msgid "Installing Restic via %s..."
msgstr "通过 %s 安装 Restic..."

msgid ""
"The current package manager does not ship restic, downloading it from "
"GitHub..."
msgstr "当前包管理器不直接提供 restic，从 GitHub 下载..."

msgid "The restic command was not found after the install, check PATH"
msgstr "安装后找不到 restic 命令，请检查 PATH"

msgid "🎉 Restic installation complete!"
msgstr "🎉 Restic 安装完成！"

#, sh-printf-format
msgid "Version info: %s"
msgstr "版本信息：%s"

msgid "Getting started:"
msgstr "快速上手："

msgid "Initialize a local backup repository"
msgstr "初始化本地备份仓库"

msgid "Back up a directory"
msgstr "备份目录"

msgid "List the backup snapshots"
msgstr "查看备份快照"

msgid "Restore a file"
msgstr "恢复文件"

msgid "Initialize a remote repository (S3 example)"
msgstr "初始化远程仓库（S3 示例）"

msgid "More usage: https://restic.readthedocs.io/"
msgstr "更多用法：https://restic.readthedocs.io/"

msgid "About to uninstall Restic."
msgstr "即将卸载 Restic。"

msgid "Install or update Restic (default action)"
msgstr "安装或更新 Restic（默认动作）"

msgid "Uninstall Restic"
msgstr "卸载 Restic"

msgid "macOS ships with an application firewall, so UFW does not apply."
msgstr "自带应用程序防火墙，UFW 不适用。"

msgid "To configure the macOS firewall: System Settings > Network > Firewall"
msgstr "如需配置 macOS 防火墙：系统设置 > 网络 > 防火墙"

#, sh-printf-format
msgid "Starting the UFW firewall installation (package manager: %s)"
msgstr "开始安装 UFW 防火墙（包管理器：%s）"

#, sh-printf-format
msgid "UFW detected (%s)"
msgstr "检测到已安装 UFW（%s）"

msgid "Continue and reconfigure the default rules?"
msgstr "是否继续并重新配置默认规则？"

msgid "Installing ufw..."
msgstr "安装 ufw..."

msgid "Installation failed: the ufw command was not found"
msgstr "安装失败：找不到 ufw 命令"

msgid "Configuring the default policy..."
msgstr "配置默认策略..."

msgid ""
"[IMPORTANT] Allow SSH (port 22) so remote access is not lost once the "
"firewall is enabled"
msgstr "【关键】放行 SSH（22 端口），防止启用防火墙后无法远程连接"

msgid "Optional: allow the common web ports"
msgstr "可选：放行常用 Web 端口"

msgid "Allow HTTP (80) and HTTPS (443)?"
msgstr "是否放行 HTTP（80）和 HTTPS（443）？"

msgid "Allowed 80/tcp and 443/tcp"
msgstr "已放行 80/tcp 和 443/tcp"

msgid ""
"Skipped allowing the web ports (add them later with: sudo ufw allow 80/tcp)"
msgstr "跳过 Web 端口放行（后续可手动添加：sudo ufw allow 80/tcp）"

msgid "Enabling the UFW firewall..."
msgstr "启用 UFW 防火墙..."

msgid "The firewall has been enabled"
msgstr "防火墙已启用"

msgid "Current rules:"
msgstr "当前规则："

msgid "Common management commands:"
msgstr "常用管理命令："

msgid "View the status"
msgstr "查看状态"

msgid "Detailed status (including the rules)"
msgstr "详细状态（含规则）"

msgid "Allow a port"
msgstr "放行端口"

msgid "Deny a port"
msgstr "拒绝端口"

msgid "Delete a rule"
msgstr "删除规则"

msgid "Reload the rules"
msgstr "重新加载规则"

msgid "Uninstall the UFW firewall? All firewall rules will be lost afterwards."
msgstr "确认卸载 UFW 防火墙？卸载后防火墙规则将全部失效。"

msgid "Disabling UFW..."
msgstr "禁用 UFW..."

msgid "Removing the ufw package..."
msgstr "卸载 ufw 包..."

msgid "Failed to remove the package, uninstall it manually"
msgstr "包移除失败，请手动卸载"

msgid "The firewall has been uninstalled and disabled."
msgstr "防火墙已卸载并禁用。"

msgid ""
"Note: after the uninstall the system has no firewall protection, make sure "
"you have other safeguards."
msgstr "注意：卸载后系统将不再有防火墙保护，请确保有其他安全措施。"

msgid "Not applicable (macOS ships with an application firewall)"
msgstr "不适用（macOS 自带应用程序防火墙）"

msgid "Configuration path: System Settings > Network > Firewall"
msgstr "配置路径：系统设置 > 网络 > 防火墙"

msgid "Installed and enabled"
msgstr "已安装并启用"

msgid "Installed but not enabled"
msgstr "已安装但未启用"

msgid "Installed and the service is running (degraded detection)"
msgstr "已安装且服务运行中（降级检测）"

msgid "Installed (sudo unavailable, degraded detection)"
msgstr "已安装（sudo 不可用，降级检测）"

msgid "Installed (the detailed status cannot be read)"
msgstr "已安装（无法读取详细状态）"

msgid ""
"Install and enable the UFW firewall (set the default policy and allow SSH)"
msgstr "安装并启用 UFW 防火墙（配置默认策略 + 放行 SSH）"

msgid "Disable and uninstall UFW"
msgstr "禁用并卸载 UFW"

msgid "View the firewall status and rules"
msgstr "查看防火墙状态和规则"

msgid "Show the help"
msgstr "显示帮助"

msgid ""
"⚠️  Security note: SSH (port 22) is allowed automatically before the firewall "
"is enabled, so remote access is not locked out."
msgstr ""
"⚠️  安全提示：启用防火墙前会自动放行 SSH（22 端口），防止远程连接被锁定。"

msgid "📂 Installing upftp (a lightweight FTP file sharing tool)"
msgstr "📂 安装 upftp（轻量级 FTP 文件分享工具）"

#, sh-printf-format
msgid "upftp detected (%s)"
msgstr "检测到已安装 upftp（%s）"

msgid "Continue and update?"
msgstr "是否继续并更新？"

msgid "Installing via Homebrew..."
msgstr "通过 Homebrew 安装..."

msgid ""
"Cannot fetch the latest upftp version (check the network or set GH_TOKEN)"
msgstr "无法获取 upftp 最新版本（请检查网络或设置 GH_TOKEN）"

#, sh-printf-format
msgid "Trying the bare binary: %s"
msgstr "尝试裸二进制：%s"

#, sh-printf-format
msgid ""
"Download failed, download it manually from https://github.com/%s/releases"
msgstr "下载失败，请从 https://github.com/%s/releases 手动下载"

msgid "The upftp binary was not found in the archive"
msgstr "未在压缩包中找到 upftp 二进制"

msgid "It may have been installed outside the PATH, please check"
msgstr "可能装到非 PATH 路径，请检查"

msgid "Share the current directory (FTP 2121 / HTTP 8080)"
msgstr "分享当前目录（FTP 2121 / HTTP 8080）"

msgid "Specify a directory and a port"
msgstr "指定目录和端口"

msgid "Read-only mode"
msgstr "只读模式"

msgid "Background service mode"
msgstr "后台服务模式"

msgid "Open http://<your IP>:8080 in a browser to reach the web interface"
msgstr "浏览器打开 http://<你的IP>:8080 访问 Web 界面"

msgid "Install upftp (the FTP file sharing tool, default action)"
msgstr "安装 upftp（FTP 文件分享工具，默认动作）"

